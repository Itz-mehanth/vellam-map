# URL of the deployed API, no trailing slash. Leave empty in local dev (Vite proxies /api).
VITE_API_BASE=
# Optional: enables the Live traffic overlay (free key from developer.tomtom.com)
VITE_TOMTOM_KEY=

# The public address of the site (no trailing slash). Link previews (og:image, canonical) need
# an absolute URL. On Vercel this is filled in automatically from the production domain.
VITE_SITE_URL=
